# Required: Production Database local:sqlite:///./cardvault.db
DATABASE_URL=postgresql://username:password@host:5432/database

# Required: JWT Secret (generate a strong random string)
SECRET_KEY=change-me-to-a-32-char-random-secret

# Required: CORS origins (comma-separated, NO spaces between commas)
# Use your actual frontend domains. Wildcard (*) breaks auth requests in browsers.
# Example for separate frontend + API deployments:
CORS_ORIGINS=https://cardvault-ciims.vercel.app,http://localhost:5173

# Optional: Mock API URLs
FLEXCUBE_API_URL=http://mock-flexcube/api
CMS_API_URL=http://mock-cms/api

# Frontend
VITE_API_BASE_URL=/api
