{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/index.py",
      "use": "@vercel/fastapi"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/vite",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/backend/(.*)",
      "dest": "backend/api/index.py"
    },
    {
      "src": "/frontend/(.*)",
      "dest": "frontend/dist/$1"
    }
  ],
  "env": {
    "PYTHONPATH": "backend"
  }
}
